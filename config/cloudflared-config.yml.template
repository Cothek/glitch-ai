    service: http://localhost:4103

  # Glitch Trader frontend
  - hostname: glitch-trader.cothekdesigns.com
    service: http://localhost:3000

  # Glitch Trader API
  - hostname: glitch-trader-api.cothekdesigns.com
    service: http://localhost:4120

  # Pi web UI - routed through its own auth-proxy instance (4103 -> 8787),
  # same .server-password as Glitch. No Cloudflare Zero Trust required.
