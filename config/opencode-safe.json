{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "opencode",
    "opencode-go",
    "nvidia",
    "openrouter"
  ],
  "agent": {
    "glitch": {
      "mode": "primary",
      "description": "Safe mode -- troubleshoot and repair Glitch configuration",
      "color": "#e74c3c",
      "temperature": 0.2,
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "question": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "task": "allow"
      },
      "prompt": "You are Glitch running in SAFE MODE. Something is broken with the Glitch configuration and Troy needs your help to fix it.\n\n## Safe Mode Rules\n1. You have FULL permissions (edit, bash, task) -- use them to diagnose and fix problems.\n2. The current opencode.json may be corrupted or incompatible. Check it first.\n3. Listen to Troy's description of what went wrong and systematically diagnose:\n   - Check opencode.json for syntax errors\n   - Check for missing files referenced in config\n   - Check for incompatible config keys\n   - Check that git submodules are initialized\n4. After fixing, tell Troy to exit safe mode and launch normally.\n5. If you can't fix it, restore a known-good backup from data/backups/.\n6. Stay focused on repair -- no new features, no dev work.\n\n## CRITICAL: Where to Apply Fixes\n- The current opencode.json is the TEMPORARY safe mode config. Any changes to it will be lost on next normal launch (it gets overwritten by the template).\n- To make permanent fixes, either:\n  a) Fix the source template at config/opencode-normal.json (if the normal config was the problem)\n  b) Fix the files that opencode.json references (if instructions, agent prompts, etc. have errors)\n- After fixing, tell Troy to exit safe mode and launch normally."
    },
    "scout": {
      "model": "opencode/deepseek-v4-flash-free",
      "mode": "subagent",
      "description": "Demand researcher for the money operation. Read-only by construction: webfetch/websearch/read/glob/grep ONLY. Never writes files, never runs bash, never touches credentials. Returns structured play proposals.",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "deny",
        "todowrite": "allow",
        "task": "deny",
        "skill": "allow"
      },
      "temperature": 0.2
    },
    "validator": {
      "model": "opencode/deepseek-v4-flash-free",
      "mode": "subagent",
      "description": "Market validator for the money operation. Builds a landing page + waitlist for an approved play using read/write/edit/webfetch/websearch. No bash, no task, no credentials. Output goes to the business dir only.",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "deny",
        "todowrite": "allow",
        "task": "deny",
        "skill": "allow"
      },
      "temperature": 0.2
    }
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "server": {
    "port": 4100,
    "hostname": "0.0.0.0"
  },
  "default_agent": "glitch",
  "provider": {
